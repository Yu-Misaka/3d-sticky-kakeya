/- This fragment is appended to the imports generated by check.py. -/
open Lean Elab Command

def blueprintAudit (names : Array Name) : CommandElabM Unit := do
  let env ← getEnv
  for name in names do
    let some info := env.find? name
      | throwError "Blueprint declaration does not exist: {name}"
    let some idx := env.getModuleIdxFor? name
      | throwError "No defining module for blueprint declaration: {name}"
    let some ranges ← findDeclarationRanges? name
      | throwError "No source position for blueprint declaration: {name}"
    let axioms ← collectAxioms name
    let kind := match info with
      | .thmInfo _ => "theorem"
      | .defnInfo _ => "definition"
      | .inductInfo _ => "inductive"
      | .axiomInfo _ => "axiom"
      | .opaqueInfo _ => "opaque"
      | .ctorInfo _ => "constructor"
      | .recInfo _ => "recursor"
      | .quotInfo _ => "quotient"
    let record := Json.mkObj [
      ("name", toJson name.toString),
      ("module", toJson env.header.moduleNames[idx]!.toString),
      ("line", toJson ranges.selectionRange.pos.line),
      ("kind", toJson kind),
      ("axioms", toJson ((axioms.map Name.toString).qsort (· < ·)))]
    liftIO <| IO.println ("BLUEPRINT " ++ record.compress)
